  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1320px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": false,
   "customGradient": false,
   "palette": [
    {
     "slug": "ink",
     "name": "Dark Teal",
     "color": "#0b303b"
    },
    {
     "slug": "paper",
     "name": "Soft White",
     "color": "#fef4ee"
    },
    {
     "slug": "soft",
     "name": "Lime",
     "color": "#e2fdc7"
    },
    {
     "slug": "peach",
     "name": "Peach",
     "color": "#ff9c61"
    },
    {
     "slug": "depth",
     "name": "Indigo",
     "color": "#5454d2"
    },
    {
     "slug": "ink-muted",
     "name": "Teal gedämpft",
     "color": "#4a6670"
    },
    {
     "slug": "line",
     "name": "Linie hell",
     "color": "#e6dcd5"
    },
    {
     "slug": "white",
     "name": "Weiß",
     "color": "#ffffff"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": true,
   "fontFamilies": [
    {
     "slug": "montserrat",
     "name": "Montserrat",
     "fontFamily": "Montserrat, Arial, Helvetica, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Montserrat",
       "fontStyle": "normal",

     "fontFace": [
      {
       "fontFamily": "Nunito",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunito-latin-wght-normal.woff2"
       ],
       "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
      },
      {
       "fontFamily": "Nunito",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunito-latin-ext-wght-normal.woff2"
       ],
       "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
      },
      {
       "fontFamily": "Nunito",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunito-latin-wght-italic.woff2"
       ],
       "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
      },
      {
       "fontFamily": "Nunito",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunito-latin-ext-wght-italic.woff2"
       ],
       "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "label",
     "name": "Label",
     "size": "13px",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Klein",
     "size": "16px",
     "fluid": false
    },
    {
     "slug": "body",
     "name": "Text",
     "size": "18px",
     "fluid": false
    },
    {
     "slug": "lead",
     "name": "Einleitung",
     "size": "20px",
     "fluid": {
      "min": "18px",
      "max": "20px"
     }
    },
    {
     "slug": "h3",
     "name": "H3",
     "size": "24px",
     "fluid": {
      "min": "20px",
      "max": "24px"
     }
    },
    {
     "slug": "h2",
     "name": "H2",
     "size": "42px",
     "fluid": {
      "min": "28px",
      "max": "42px"
     }
    },
    {
     "slug": "h1",
     "name": "H1",
     "size": "60px",
     "fluid": {
      "min": "36px",
      "max": "60px"
     }
    },
    {
     "slug": "display",
     "name": "Claim",
     "size": "80px",
     "fluid": {
      "min": "34px",
      "max": "80px"
     }
    }
   ]
  },
  "spacing": {
   "defaultSpacingSizes": false,
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "8px"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "16px"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "24px"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(48px, 7vw, 96px)"
    },
    {
     "slug": "70",
     "name": "XXL",
     "size": "clamp(88px, 11vw, 160px)"
    }
   ]
  },
  "shadow": {
   "defaultPresets": false
  },
  "custom": {
   "gutter": "clamp(20px, 3vw, 32px)"
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--nunito)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "lineHeight": "1.6"
  },
  "spacing": {
   "padding": {
    "left": "var(--wp--custom--gutter)",
    "right": "var(--wp--custom--gutter)",
    "top": "0",
    "bottom": "0"
   },
   "blockGap": "24px"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--depth)"
     }
    },
    ":focus": {
     "outline": {
      "color": "var(--wp--preset--color--depth)",
      "offset": "2px",
      "style": "solid",
      "width": "2px"
     }
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--montserrat)",
     "fontWeight": "800",
     "lineHeight": "1.12",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h1)",
     "lineHeight": "1.08",
     "letterSpacing": "-0.02em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h2)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h3)",
     "lineHeight": "1.25"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "20px",
     "fontWeight": "700",
     "lineHeight": "1.3"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "8px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--montserrat)",
     "fontWeight": "700",
     "fontSize": "16px",
     "lineHeight": "1.2"
    },
    "spacing": {
     "padding": {
      "top": "16px",
      "bottom": "16px",
      "left": "28px",
      "right": "28px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--depth)",
      "text": "var(--wp--preset--color--white)"
     }
    },
    ":focus": {
     "outline": {
      "color": "var(--wp--preset--color--depth)",
      "offset": "3px",
      "style": "solid",
      "width": "2px"
     }
    }
   },
   "caption": {
    "color": {
     "text": "var(--wp--preset--color--ink-muted)"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--montserrat)",
     "fontWeight": "800",
     "fontSize": "19px",
     "letterSpacing": "-0.01em"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--montserrat)",
     "fontWeight": "600",
     "fontSize": "15px"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/quote": {
    "border": {
     "width": "0"
    },
    "typography": {
     "fontStyle": "italic",
     "fontWeight": "700",
     "fontSize": "var(--wp--preset--font-size--lead)"
    },
    "color": {
     "text": "var(--wp--preset--color--depth)"
    }
   },
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "border": {
     "width": "1px 0 0 0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-humor-risk-check",
   "title": "Humor Risk Check",
   "postTypes": [
    "page"
   ]
  }
 ]
}